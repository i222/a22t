{
  "typescript.preferences.importModuleSpecifier": "relative", // Prefer relative imports like './module' over absolute paths

  "workbench.colorCustomizations": {
    "editor.background": "#F5FAFF", // Background color of the editor
    "editor.foreground": "#002B4D", // Default text color in the editor
    "editorCursor.foreground": "#007ACC", // Color of the text cursor
    "editor.lineHighlightBackground": "#E0F0FF", // Highlight color for the current line
    "editor.selectionBackground": "#D6ECFF", // Background color for selected text
    "editor.inactiveSelectionBackground": "#EAF6FF", // Selection background in inactive editors
    "editorLineNumber.foreground": "#80A0C0", // Color of line numbers
    "editorWhitespace.foreground": "#C0D8E8", // Color for visible whitespace (spaces, tabs)

    "sideBar.background": "#F0F8FF", // Background color of the sidebar (Explorer, etc.)
    "sideBar.foreground": "#2A3B50", // Text color in the sidebar

    "activityBar.background": "#4C6E7E", // Background of the vertical activity bar (left side)
    "activityBar.foreground": "#F0F8FF", // Icon color in the activity bar

    "statusBar.background": "#B1D0F0", // Background color of the status bar (bottom bar)
    "statusBar.foreground": "#001A33", // Text color in the status bar

    "titleBar.activeBackground": "#5C90C4", // Background of the title bar when active
    "titleBar.activeForeground": "#F0F8FF", // Text color in the active title bar

    "tab.activeBackground": "#D8ECFF", // Background of the active tab
    "tab.inactiveBackground": "#F5F9FB", // Background of inactive tabs
    "tab.activeForeground": "#002244", // Text color of the active tab
    "tab.inactiveForeground": "#607C96" // Text color of inactive tabs
  }
}
