{
  "identifier": "com.i222.a22.PoC",
  "productName": "a22t-tauri-app",
  "version": "0.1.0",
  "app": {
    "windows": [
      {
        "title": "Tauri App",
        "label": "main",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000 file://*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for the app",
          "remote": {
            "urls": [
              "https://*",
              "http://localhost:3000",
              "file://*",
              "http://*"
            ]
          },
          "window": [
            "main",
            "*"
          ],
          "webview": [
            "main",
            "*"
          ],
          "platforms": [
            "macOS",
            "windows",
            "linux",
            "android",
            "iOS"
          ],
          "permissions": [
            "core:default",
            "core:event:allow-emit",
            "core:event:allow-listen",
            "core:webview:allow-create-webview",
            "core:webview:allow-create-webview-window",
            "core:webview:allow-get-all-webviews",
            "core:webview:allow-webview-close",
            "core:webview:allow-webview-hide",
            "core:webview:allow-webview-show",
            "core:webview:allow-webview-size",
            "core:webview:allow-set-webview-size",
            "core:webview:allow-set-webview-zoom",
            "core:window:default"
          ],
          "scope": {
            "allow": {
              "core:event:default": [
                "local",
                "http://localhost:3000",
                "file://*",
                "http://*"
              ],
              "core:event:allow-listen": [
                "*",
                "local",
                "http://localhost:*",
                "http://localhost:3000",
                "http://localhost:3000/",
                "file://*",
                "http://*"
              ],
              "core:event:allow-emit": [
                "*",
                "local",
                "http://localhost:3000",
                "file://*",
                "http://*"
              ]
            }
          }
        }
      ]
    }
  },
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../ui-react/dist"
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "files": {}
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": []
  },
  "plugins": {}
}